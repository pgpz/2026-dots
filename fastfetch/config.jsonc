{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "~/.config/fastfetch/yuji.txt",
        "type": "file",
        "height": 15,
        "width": 30,
        "color": {
            "1": "#00ff00"
        },
        "padding": {
            "top": 1,
            "left": 1
        }
    },

    "modules": [
        "break",


        {
      "type": "command",
      "key": "greetings;",
      "text": "hour=$(date +%H); if (( hour < 12 )); then printf 'good morning, pgp!'; elif (( hour < 18 )); then printf 'good afternoon, pgp!'; else printf 'good evening, pgp!'; fi",
      "outputColor": "green"
    },

        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────sys utils──────────────────────┐"
        },

        {
            "type": "os",
            "key": "  OS",
            "keyColor": "yellow"
        },

        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "yellow"
        },

        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "yellow"
        },

        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "yellow"
        },

        {
            "type": "shell",
            "key": "│ ├󰞷 ",
            "keyColor": "yellow"
        },

        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "green"
        },

        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "green"
        },

        {
            "type": "memory",
            "key": "└ └󰑭 ",
            "keyColor": "green"
        },

        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },

        "break",

        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "blue"
        },

        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "blue"
        },

        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "blue"
        },

        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "blue"
        },

        {
            "type": "terminal",
            "key": "└ └󰆍 ",
            "keyColor": "blue"
        },

        "break",

        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────Uptime / Age / DT────────────────────┐"
        },

        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },

        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "magenta"
        },

        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "magenta"
        },

        {
            "type": "custom",
            "format": "\u001b[90m└─────────────────────────────────────────────────────────┘"
        },

        {
            "type": "colors",
            "paddingLeft": 22,
            "symbol": "circle"
        }
    ]
}
